# Rust
/target/
**/*.rs.bk

# makepkg build artefacts. Note that packages/*/src is makepkg's OWN scratch
# directory ($srcdir is literally $startdir/src) — our payload lives in
# packages/*/files, which is checked in and must never be ignored.
packages/*/src/
packages/*/pkg/
packages/*/*.pkg.tar.*
packages/*/*.log

# Generated by packages/prepare-workspace-source.sh for the packages that build
# from the whole workspace rather than from files beside their PKGBUILD.
packages/*/steel-os-*.tar.gz

# ISO build output
/iso/out/
/iso/work/
*.iso
*.iso.sha256

# Image build output
/image/out/
/image/cache/
*.raw
*.efi
*.verity

# Never commit key material. The repo ships public keys and nothing else.
*.key
*.pem
!**/*.pub
sbctl-keys/
secring.*

# Python bytecode. The installer modules are imported by the test suite, which
# leaves these behind next to the sources.
__pycache__/
*.pyc
