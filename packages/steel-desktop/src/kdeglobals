# Plasma privacy defaults, applied system-wide via /etc/xdg.
#
# These are defaults, not policy: a user can change any of them in System
# Settings, and should be able to. They exist because the shipped defaults leak
# in ways that are invisible until they matter.

[General]
# Thumbnails for files on removable and network media are generated by parsing
# untrusted files with a long list of format libraries, and the results are
# cached in the user's home. Both halves are a problem: the parsing is remote
# code execution surface reachable by plugging in a USB stick, and the cache is
# a durable record of what was on media the user may have handed back.
[PreviewSettings]
MaximumRemoteSize=0
EnableRemoteFolderThumbnail=false

[KDE]
# No file-open recent-documents history by default. It is a plaintext index of
# every document touched, kept in the home directory, and it survives the
# documents themselves.
ShowDeleteCommand=false

[RecentDocuments]
UseRecent=false
MaxEntries=0

[Sonnet]
# Spell-check dictionaries are local; nothing here phones home. Listed
# explicitly so a future change that does is visible in review.
checkerEnabledByDefault=true

[KFileDialog Settings]
# Do not show hidden files by default in the file dialog handed to sandboxed
# applications: the portal file chooser is what grants access, and a user who
# can see ~/.ssh in it is one misclick from granting it.
Show hidden files=false
