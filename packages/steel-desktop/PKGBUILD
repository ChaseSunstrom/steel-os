# Maintainer: SteelOS <security@steelos.invalid>
pkgname=steel-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc="SteelOS desktop defaults: removable-media mount policy, lock-on-suspend, privacy settings"
arch=('any')
url="https://github.com/ChaseSunstrom/steel-os"
license=('GPL-3.0-or-later')
depends=('systemd')
optdepends=(
  'udisks2: removable media mount policy applies to udisks-managed mounts'
  'plasma-desktop: the desktop these defaults are written for'
  'steel-check: verify the policy is in force'
)
backup=(
  'etc/udisks2/mount_options.conf'
  'etc/systemd/logind.conf.d/99-steel.conf'
  'etc/xdg/kdeglobals'
)

# Payload sits next to this PKGBUILD, listed by plain filename. makepkg resolves
# a local source= entry by BASENAME against $startdir, so 'src/sysctl/foo.conf'
# is looked for as 'foo.conf' beside the PKGBUILD and never found — that is what
# broke the packaging job. Reaching out with $startdir instead breaks in a clean
# chroot and namcap rejects it, and a payload directory named src/ is deleted by
# makepkg --clean, because $srcdir is literally $startdir/src.
source=(
  'udisks2-mount-options.conf'
  'logind-steel.conf'
  'kdeglobals'
)
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 "$srcdir/udisks2-mount-options.conf" \
    "$pkgdir/etc/udisks2/mount_options.conf"
  install -Dm644 "$srcdir/logind-steel.conf" \
    "$pkgdir/etc/systemd/logind.conf.d/99-steel.conf"
  install -Dm644 "$srcdir/kdeglobals" "$pkgdir/etc/xdg/kdeglobals"
}
