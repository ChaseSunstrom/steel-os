# Maintainer: SteelOS <security@steelos.invalid>
#
# Packages steelctl: the manifest schema and the deployment engine.

pkgname=steel-config
pkgver=0.1.0
pkgrel=1
pkgdesc="SteelOS manifest engine: steelctl apply/diff/update/rollback/history"
arch=('x86_64' 'aarch64')
url="https://github.com/ChaseSunstrom/steel-os"
license=('GPL-3.0-or-later')
depends=()
makedepends=('rust' 'cargo')
optdepends=(
  'steel-boot: slot activation and boot counting'
  'systemd: sysupdate performs the image transfer steelctl schedules'
)
backup=('etc/steelos/manifest.toml')

# Built from the workspace snapshot produced by
# packages/prepare-workspace-source.sh — see packages/steel-check/PKGBUILD for
# why makepkg cannot take the workspace directory as a local source.
source=("steel-os-$pkgver.tar.gz")
sha256sums=('SKIP')
_src="steel-os-$pkgver"

build() {
  cd "$srcdir/$_src"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --release --frozen --package steelctl
}

check() {
  cd "$srcdir/$_src"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --release --frozen --package steelctl
}

package() {
  cd "$srcdir/$_src"
  install -Dm755 target/release/steelctl "$pkgdir/usr/bin/steelctl"
  # The default manifest becomes the user's starting point, and is also kept
  # unmodified under /usr/share so `steelctl` can show what changed from stock.
  install -Dm644 image/manifest.default.toml "$pkgdir/etc/steelos/manifest.toml"
  install -Dm644 image/manifest.default.toml \
    "$pkgdir/usr/share/$pkgname/manifest.default.toml"
}
