#!/usr/bin/env bash
#
# steel-malloc — manage the hardened_malloc preload.
#
# CLAUDE.md, design principle 6: every hardening measure must be reversible and
# documented, or users disable everything instead of one control. This is that
# escape hatch for the allocator, and gotcha 7 is why it needs to be a good one
# — hardened_malloc breaks games and some proprietary applications, and the
# failure looks like a crash on startup with no explanation.

set -euo pipefail

PRELOAD_FILE=${STEEL_MALLOC_PRELOAD:-/etc/ld.so.preload}
EXEMPT_FILE=${STEEL_MALLOC_EXEMPT:-/etc/steelos/malloc-exempt}
LIBDIR=${STEEL_MALLOC_LIBDIR:-/usr/lib}

LIGHT="$LIBDIR/libhardened_malloc-light.so"
FULL="$LIBDIR/libhardened_malloc.so"

die() { printf 'steel-malloc: %s\n' "$*" >&2; exit 1; }
note() { printf 'steel-malloc: %s\n' "$*"; }

need_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || die "must be run as root"
}

current_line() {
  [[ -f $PRELOAD_FILE ]] || return 0
  grep -E 'hardened_malloc' "$PRELOAD_FILE" || true
}

# Remove our line without touching anyone else's. /etc/ld.so.preload is shared
# state; rewriting the whole file would silently drop another package's entry.
strip_our_line() {
  [[ -f $PRELOAD_FILE ]] || return 0
  local tmp
  tmp=$(mktemp)
  grep -Ev 'hardened_malloc' "$PRELOAD_FILE" > "$tmp" || true
  install -Dm644 "$tmp" "$PRELOAD_FILE"
  rm -f "$tmp"
}

set_variant() {
  local lib=$1
  [[ -f $lib ]] || die "$lib does not exist — is hardened_malloc installed?"
  need_root
  strip_our_line
  printf '%s\n' "$lib" >> "$PRELOAD_FILE"
  chmod 644 "$PRELOAD_FILE"
  note "preloading $lib"
}

cmd_enable() {
  # Light by default. The full variant's extra checks break more software, and
  # an unusable secure system gets replaced with a usable insecure one.
  set_variant "$LIGHT"
}

cmd_disable() {
  need_root
  strip_our_line
  note "preload removed; a reboot is not required, but running processes keep the allocator they started with"
}

cmd_variant() {
  case ${1:-} in
    light) set_variant "$LIGHT" ;;
    full)
      set_variant "$FULL"
      note "the full variant enables slot randomisation and larger guard regions; expect more application breakage"
      ;;
    "") current_line | grep -q -- '-light' && echo light || { current_line | grep -q . && echo full || echo none; } ;;
    *) die "unknown variant: $1 (expected light or full)" ;;
  esac
}

# A preload line pointing at a library that does not exist is silently ignored
# by the dynamic loader: nothing is protected and nothing warns you. That is the
# single worst state this tool can leave a system in, so repair exists to detect
# and fix it, and steel-check reports it as a failure rather than a pass.
cmd_repair() {
  need_root
  local line
  line=$(current_line)
  if [[ -z $line ]]; then
    note "no hardened_malloc preload configured; nothing to repair"
    return 0
  fi
  if [[ -f $line ]]; then
    note "preload is intact: $line"
    return 0
  fi
  note "preload points at a missing library ($line) — the loader has been ignoring it"
  if [[ $line == *-light.so ]]; then
    set_variant "$LIGHT"
  else
    set_variant "$FULL"
  fi
}

# Per-binary exemption.
#
# ld.so.preload is unconditional, so the only way to exempt a program is to stop
# it inheriting the preload: a wrapper that clears LD_PRELOAD for that one
# executable. The wrapper lives in /usr/local/bin, which precedes /usr/bin in
# the default PATH.
cmd_exempt() {
  need_root
  local target=${1:?usage: steel-malloc exempt <path-to-binary>}
  [[ -x $target ]] || die "$target is not an executable"
  local name wrapper
  name=$(basename "$target")
  wrapper="/usr/local/bin/$name"

  [[ -e $wrapper ]] && die "$wrapper already exists; remove it first"

  cat > "$wrapper" <<EOF
#!/usr/bin/env bash
# Generated by steel-malloc: run $name without the hardened_malloc preload.
# Remove this file to put $name back under the allocator.
exec env LD_PRELOAD= "$target" "\$@"
EOF
  chmod 755 "$wrapper"

  grep -qxF "$target" "$EXEMPT_FILE" 2>/dev/null || printf '%s\n' "$target" >> "$EXEMPT_FILE"
  note "exempted $target via $wrapper"
  note "this is recorded in $EXEMPT_FILE so the exception is visible rather than forgotten"
}

cmd_unexempt() {
  need_root
  local target=${1:?usage: steel-malloc unexempt <path-to-binary>}
  local wrapper="/usr/local/bin/$(basename "$target")"
  if [[ -f $wrapper ]] && grep -q 'Generated by steel-malloc' "$wrapper"; then
    rm -f "$wrapper"
    note "removed $wrapper"
  fi
  if [[ -f $EXEMPT_FILE ]]; then
    local tmp
    tmp=$(mktemp)
    grep -vxF "$target" "$EXEMPT_FILE" > "$tmp" || true
    install -Dm644 "$tmp" "$EXEMPT_FILE"
    rm -f "$tmp"
  fi
}

cmd_status() {
  local line
  line=$(current_line)
  if [[ -z $line ]]; then
    echo "preload:  none"
  elif [[ -f $line ]]; then
    echo "preload:  $line (present)"
  else
    echo "preload:  $line (MISSING — the loader is ignoring it, run 'steel-malloc repair')"
  fi
  echo "variant:  $(cmd_variant)"
  echo "exempt:"
  if [[ -s $EXEMPT_FILE ]]; then
    grep -v '^#' "$EXEMPT_FILE" | grep -v '^$' | sed 's/^/  /' || true
  else
    echo "  (none)"
  fi
}

usage() {
  cat <<'EOF'
steel-malloc — manage the hardened_malloc preload

USAGE:
    steel-malloc <command> [args]

COMMANDS:
    status                  Show the current preload, variant, and exemptions
    enable                  Preload the light variant (the default)
    disable                 Remove the preload entirely
    variant [light|full]    Show or set the variant
    repair                  Fix a preload pointing at a missing library
    exempt <binary>         Run one program without the allocator
    unexempt <binary>       Undo an exemption

WHY YOU MIGHT NEED THIS:
    hardened_malloc turns heap corruption bugs into crashes instead of
    exploits. It also refuses several things that working software does
    anyway — games and proprietary applications are the usual casualties,
    and they fail by crashing immediately on startup.

    Exempt the one program rather than disabling the allocator. There is
    also a boot entry with the preload disabled, for the case where the
    thing that will not start is the desktop session.
EOF
}

case ${1:-} in
  status)    shift; cmd_status "$@" ;;
  enable)    shift; cmd_enable "$@" ;;
  disable)   shift; cmd_disable "$@" ;;
  variant)   shift; cmd_variant "$@" ;;
  repair)    shift; cmd_repair "$@" ;;
  exempt)    shift; cmd_exempt "$@" ;;
  unexempt)  shift; cmd_unexempt "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
