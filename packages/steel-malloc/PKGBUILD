# Maintainer: SteelOS <security@steelos.invalid>
pkgname=steel-malloc
pkgver=0.1.0
pkgrel=1
pkgdesc="hardened_malloc preload management for SteelOS, with per-binary exemptions"
arch=('any')
url="https://github.com/ChaseSunstrom/steel-os"
license=('GPL-3.0-or-later')
depends=('hardened_malloc' 'bash')
optdepends=('steel-check: verify the preload is actually in force')
backup=('etc/steelos/malloc-exempt')

install=steel-malloc.install

# Payload sits next to this PKGBUILD, listed by plain filename. makepkg resolves
# a local source= entry by BASENAME against $startdir, so 'src/sysctl/foo.conf'
# is looked for as 'foo.conf' beside the PKGBUILD and never found — that is what
# broke the packaging job. Reaching out with $startdir instead breaks in a clean
# chroot and namcap rejects it, and a payload directory named src/ is deleted by
# makepkg --clean, because $srcdir is literally $startdir/src.
source=(
  'steel-malloc'
  'malloc-exempt'
)
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/steel-malloc" "$pkgdir/usr/bin/steel-malloc"
  install -Dm644 "$srcdir/malloc-exempt" "$pkgdir/etc/steelos/malloc-exempt"
}
